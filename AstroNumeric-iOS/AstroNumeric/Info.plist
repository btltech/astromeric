<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>https://astromeric-backend-production.up.railway.app</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.astromeric.app.transitScan</string>
		<string>com.astromeric.app.cachePrewarm</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AstroNumeric</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AstroNumeric</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>AstroNumeric reads your upcoming calendar events to show how they line up with planetary timing. If you turn on calendar context in the Cosmic Guide, only the day and time of day of upcoming events are included in your question, never their titles or details.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We need your location to determine your birthplace timezone.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>AstroNumeric uses your microphone to record voice journal entries using live speech-to-text transcription.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AstroNumeric saves the reading cards you choose to your photo library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AstroNumeric transcribes your voice journal entries into text using on-device speech recognition.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>
	<key>WEBSITE_BASE_URL</key>
	<string>https://astronumeric.com</string>
</dict>
</plist>
